// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  password String
  role     Role    @default(USER)
}

model Camper {
  id          String   @id
  name        String
  tagline     String
  pricePerDay Int
  sleep       Int
  seats       Int
  transmission String
  location    String
  rating      Float
  reviews     Int
  features    String[]
  accent      String
  images      String[]
}
